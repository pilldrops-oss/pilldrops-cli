  "create_cron_job": {
    "properties": {
      "agent_mode": {
        "description": "guided or autonomous",
        "type": "string"
      },
      "command": {
        "description": "command to run, or the prompt with agent_mode",
        "type": "string"
      },
      "name": {
        "description": "label for the job",
        "type": "string"
      },
      "sandbox_id": {
        "description": "sandbox id, not its name",
        "type": "string"
      },
      "schedule": {
        "description": "cron expression, e.g. 0 2 * * *",
        "type": "string"
      },
      "timezone": {
        "description": "IANA zone the schedule is read in; default UTC",
        "type": "string"
      }
    },
    "required": [
      "sandbox_id",
      "schedule",
      "command"
    ],
    "type": "object"
  },
  "create_function": {
    "properties": {
      "env": {
        "description": "environment variables by name",
        "type": "object"
      },
      "files": {
        "description": "source files to include",
        "items": {
          "properties": {
            "content": {
              "description": "file text",
              "type": "string"
            },
            "path": {
              "description": "path in the function",
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "max_replicas": {
        "description": "burst ceiling",
        "type": "integer"
      },
      "memory_mb": {
        "description": "memory in MB",
        "type": "integer"
      },
      "name": {
        "description": "function name",
        "type": "string"
      },
      "port": {
        "description": "port the command listens on",
        "type": "integer"
      },
      "start": {
        "description": "command that serves the function",
        "type": "string"
      },
      "template": {
        "description": "template id; default the server's first",
        "type": "string"
      },
      "vcpu": {
        "description": "vCPUs",
        "type": "integer"
      }
    },
    "required": [
      "name",
      "start"
    ],
    "type": "object"
  },
  "create_project": {
    "properties": {
      "name": {
        "description": "project name",
        "type": "string"
      },
      "plan": {
        "description": "the project's plan",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  },
  "create_sandbox": {
    "properties": {
      "env": {
        "description": "environment variables, KEY=VAL",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "idle_seconds": {
        "description": "idle auto-pause; -1 = never pause (always-on servers)",
        "type": "integer"
      },
      "image": {
        "description": "custom docker image instead of a template",
        "type": "string"
      },
      "memory_mb": {
        "description": "memory MB (0 = template default)",
        "type": "integer"
      },
      "networks": {
        "description": "opt-in network tags. Sandboxes cannot reach each other by default; two in the same org on the same node reach each other only if they share a tag, and resolve each other as \u003cslug\u003e.pd",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "ports": {
        "description": "preview ports (app must bind $PORT)",
        "items": {
          "type": "integer"
        },
        "type": "array"
      },
      "proxied_secrets": {
        "description": "vault secrets the sandbox may use but never sees: it gets NAME=pd-proxied and NAME_PROXY_URL, and the node adds the secret to calls made through that URL to host. Point the SDK's base URL at it, e.g. OPENAI_BASE_URL=$OPENAI_API_KEY_PROXY_URL/v1",
        "items": {
          "properties": {
            "format": {
              "description": "value with {} for the secret (default \"Bearer {}\"; Anthropic: \"{}\")",
              "type": "string"
            },
            "header": {
              "description": "header to set (default Authorization)",
              "type": "string"
            },
            "host": {
              "description": "the API host the secret is for, e.g. api.openai.com",
              "type": "string"
            },
            "name": {
              "description": "vault secret name",
              "type": "string"
            }
          },
          "required": [
            "name",
            "host"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "public": {
        "description": "make the preview URL reachable without a token (shareable link); default false = private",
        "type": "boolean"
      },
      "runtime": {
        "description": "pin isolation runtime: firecracker | docker (omit = auto)",
        "type": "string"
      },
      "secret_refs": {
        "description": "vault secrets (see list_secrets) to put in the sandbox's environment by name",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "slug": {
        "description": "DNS label this sandbox is hosted and resolved under; also its name on a network tag (\u003cslug\u003e.pd)",
        "type": "string"
      },
      "start": {
        "description": "long-lived app/server command; makes the sandbox serve a preview URL",
        "type": "string"
      },
      "storage_mb": {
        "description": "disk MB (0 = template default)",
        "type": "integer"
      },
      "template": {
        "description": "template id (see list_templates); default python-3.11",
        "type": "string"
      },
      "timeout_seconds": {
        "description": "sandbox lifetime (0 = plan default)",
        "type": "integer"
      },
      "vcpu": {
        "description": "vCPUs (0 = template default)",
        "type": "integer"
      },
      "volumes": {
        "description": "standalone volumes to attach (see create_volume)",
        "items": {
          "properties": {
            "id": {
              "description": "volume id",
              "type": "string"
            },
            "path": {
              "description": "where to mount it, e.g. /data",
              "type": "string"
            }
          },
          "required": [
            "id",
            "path"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "create_thread": {
    "properties": {
