{
  "add_domain": {
    "properties": {
      "host": {
        "description": "hostname, e.g. app.example.com, or *.example.com for an org wildcard",
        "type": "string"
      },
      "port": {
        "description": "the sandbox port behind the host (default 8000)",
        "type": "integer"
      },
      "sandbox_id": {
        "description": "the sandbox to serve it (omit for a wildcard)",
        "type": "string"
      }
    },
    "required": [
      "host"
    ],
    "type": "object"
  },
  "agent_ask": {
    "properties": {
      "message": {
        "description": "what to do",
        "type": "string"
      },
      "mode": {
        "description": "supervised, guided or autonomous; default the agent's own",
        "type": "string"
      },
      "priority": {
        "description": "jump the queue",
        "type": "boolean"
      },
      "sandbox_id": {
        "description": "sandbox id of an agent template",
        "type": "string"
      },
      "thread": {
        "description": "latest (default), new, or a thread id",
        "type": "string"
      }
    },
    "required": [
      "sandbox_id",
      "message"
    ],
    "type": "object"
  },
  "agent_decide_approval": {
    "properties": {
      "approval_id": {
        "description": "approval id",
        "type": "string"
      },
      "decision": {
        "description": "allow or deny",
        "type": "string"
      },
      "sandbox_id": {
        "description": "sandbox id of an agent template",
        "type": "string"
      }
    },
    "required": [
      "sandbox_id",
      "approval_id",
      "decision"
    ],
    "type": "object"
  },
  "agent_get_turn": {
    "properties": {
      "sandbox_id": {
        "description": "sandbox id of an agent template",
        "type": "string"
      },
      "turn_id": {
